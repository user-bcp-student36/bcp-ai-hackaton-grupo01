{
  "name": "@wallet/contracts",
  "private": true,
  "type": "module",
  "exports": {
    "./onboarding": {
      "types": "./src/onboarding.ts",
      "import": "./dist/onboarding.js"
    },
    "./contacts": {
      "types": "./src/contacts.ts",
      "import": "./dist/contacts.js"
    },
    "./auth": {
      "types": "./src/auth.ts",
      "import": "./dist/auth.js"
    },
    "./biometric": {
      "types": "./src/biometric.ts",
      "import": "./dist/biometric.js"
    },
    "./qr": {
      "types": "./src/qr.ts",
      "import": "./dist/qr.js"
    },
    ".": {
      "types": "./src/common.ts",
      "import": "./dist/common.js"
    }
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
